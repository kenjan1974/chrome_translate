{
  "manifest_version": 3,
  "name": "文字轉換小幫手",
  "version": "1.4",
  "description": "Alt+1簡體、Alt+2繁體、Alt+3中英、Alt+4英中、Alt+5日文漢字、Alt+6平假名、Alt+7英文站名，需OpenAI API",
  "permissions": ["storage"],
  "host_permissions": ["https://api.openai.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html"
}
